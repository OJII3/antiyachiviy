{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "@agents/*": ["./../src/agents/*"],
      "@app/*": ["./../src/app/*"],
      "@modules/*": ["./../src/modules/*"],
      "@runtime/*": ["./../src/runtime/*"],
      "@web/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
